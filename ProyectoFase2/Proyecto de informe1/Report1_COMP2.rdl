  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH 
    MEMBER [Measures].[Total Compra] AS 
        ([Measures].[Costo U] * [Measures].[Unidades])

SELECT 
    NON EMPTY { 
        [Measures].[Costo U], 
        [Measures].[Unidades], 
        [Measures].[Total Compra]
    } ON COLUMNS, 
    NON EMPTY { 
        TOPCOUNT(
            [Sucursal].[Nombre Sucursal].[Nombre Sucursal].ALLMEMBERS, 
            4, 
            [Measures].[Unidades]  -- O [Measures].[Total Compra] si prefieres el total de compra
        ) *
        [Producto].[Categoria].[Categoria].ALLMEMBERS *
        [Producto].[Nombre Producto].[Nombre Producto].ALLMEMBERS 
    } 
    DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_VALUE, MEMBER_UNIQUE_NAME 
ON ROWS 
FROM [Seminario2_201700841 1] 
CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</CommandText>
