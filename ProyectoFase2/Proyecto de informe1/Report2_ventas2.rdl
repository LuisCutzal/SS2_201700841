  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH 
    MEMBER [Measures].[Ingreso Total] AS 
        ([Measures].[Precio Unitario] * [Measures].[Unidades])

SELECT 
    NON EMPTY { 
        [Measures].[Precio Unitario], 
        [Measures].[Unidades], 
        [Measures].[Ingreso Total] 
    } ON COLUMNS, 
    NON EMPTY { 
        TOPCOUNT(
            [Sucursal].[Region].[Region].ALLMEMBERS, 
            5, 
            [Measures].[Ingreso Total]
        ) *
        [Producto].[Categoria].[Categoria].ALLMEMBERS *
        [Producto].[Marca Producto].[Marca Producto].ALLMEMBERS *
        [Producto].[Nombre Producto].[Nombre Producto].ALLMEMBERS 
    } 
    DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_VALUE, MEMBER_UNIQUE_NAME 
ON ROWS 
FROM [Seminario2_201700841] 
CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</CommandText>
